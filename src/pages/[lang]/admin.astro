---
// Admin panel: deployed separately
import { allRegions, legacyRegionAliases } from "../../lib/utils";
export function getStaticPaths() {
  return [...allRegions, ...Object.keys(legacyRegionAliases)].map(region => ({ params: { lang: region } }));
}
const lang = Astro.params.lang || "cn";
const edition = legacyRegionAliases[lang] || lang;
return Astro.redirect(`https://admin.bynaw.top/${edition}`);
---
