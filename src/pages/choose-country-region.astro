---
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import { regionGroups } from "../lib/utils";
const groups=regionGroups;
const englishRegionNames: Record<string,string> = {
  us:"United States", "ca-en":"Canada (English)", "ca-fr":"Canada (French)",
  cn:"Mainland China", hk:"Hong Kong", tw:"Taiwan",
  "sg-en":"Singapore (English)", "sg-zh":"Singapore (Simplified Chinese)",
  au:"Australia", uk:"United Kingdom", fr:"France"
};
const flag=(code:string)=>"https://flagcdn.com/w80/"+(code==="uk"?"gb":code.split("-")[0])+".png";
---
<Layout title="Choose your country or region — NAW Journal" description="Choose the country or region and language for NAW Journal">
  <Nav lang="cn" categories={[]} catLabel={(key:string)=>key} ddObj={{}} showDropdowns={false} showSearch={false}/>
  <main class="choose-wrap">
    <div class="choose-heading">
      <p class="choose-eyebrow">NAW JOURNAL</p>
      <h1>Choose your country or region.</h1>
      <p>Choose a region to view its language and available stories.</p>
    </div>
    <div class="choose-groups">
      {groups.map(group=>(
        <section class="choose-group">
          <h2>{group.label}</h2>
          <div class="choose-grid">
            {group.items.map(item=>(
              <a class="choose-item" href={'/'+item.code+'/'} onclick={'localStorage.setItem("region",'+JSON.stringify(item.code)+');localStorage.setItem("lang",'+JSON.stringify(item.lang)+')'}>
                <img src={flag(item.code)} alt="" width="28" height="19" loading="lazy"/>
                <span>{englishRegionNames[item.code] || item.name}</span>
                <span class="choose-chevron" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
    <p class="choose-footer">Some editions have no published stories yet. You can switch regions at any time.</p>
  </main>
</Layout>
<style>
.choose-wrap{max-width:1050px;margin:0 auto;padding:85px 36px 105px}
.choose-eyebrow{font-size:.75rem;font-weight:700;color:var(--txt3);letter-spacing:.17em;margin:0 0 20px}
.choose-heading{margin-bottom:65px}
.choose-heading h1{font-size:clamp(2.4rem,5vw,4.25rem);font-weight:730;letter-spacing:-.058em;line-height:1.1;max-width:770px;margin:0 0 16px}
.choose-heading>p:last-child{color:var(--txt2);font-size:1rem;margin:0}
.choose-groups{display:flex;flex-direction:column;gap:43px}
.choose-group h2{font-size:.78rem;font-weight:650;color:var(--txt3);text-transform:uppercase;letter-spacing:.1em;margin:0 0 14px}
.choose-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.choose-item{background:var(--card);border-radius:13px;box-shadow:0 0 0 1px var(--hairline);display:flex;align-items:center;gap:13px;padding:18px 17px;min-height:60px;font-size:.95rem;font-weight:500;transition:background .2s,transform .2s}
.choose-item:hover{background:var(--bg3);transform:translateY(-2px)}
.choose-item img{width:27px;height:18px;object-fit:cover;border-radius:3px;flex-shrink:0}
.choose-item span:nth-child(2){flex:1}
.choose-chevron{color:var(--txt3)}
.choose-footer{font-size:.83rem;color:var(--txt3);margin:55px 0 0}
@media(max-width:780px){.choose-wrap{padding:56px 22px 75px}.choose-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.choose-heading{margin-bottom:40px}}
@media(max-width:520px){.choose-grid{grid-template-columns:1fr}.choose-wrap{padding:45px 20px 65px}.choose-groups{gap:30px}}
</style>