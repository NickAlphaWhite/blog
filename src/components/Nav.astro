---
interface Props {
  lang: string;
  categories: string[];
  catLabel: (key: string) => string;
  ddObj: Record<string, any>;
  activeCat?: string;
  showDropdowns?: boolean;
  showSearch?: boolean;
}

const { lang, categories, catLabel, ddObj, activeCat, showDropdowns = true, showSearch = true } = Astro.props;
// Keep primary categories visible, and provide the remaining categories in "More".
const menuOrder = ["Travel", "Hotel", "Aviation", "Card", "Gastronomy", "Design", "Visual", "Music", "Literature", "Drinks", "Odor"];
const orderedCategories = [...categories].sort((a, b) => {
  const ai = menuOrder.indexOf(a), bi = menuOrder.indexOf(b);
  return (ai < 0 ? 999 : ai) - (bi < 0 ? 999 : bi);
});
const moreLabel = /^(cn|sg-zh)$/.test(lang) ? "更多" : /^(tw|hk)$/.test(lang) ? "更多" : /^(fr|ca-fr)$/.test(lang) ? "Plus" : "More";

---
<nav class="nav">
  <div class="nav-inner">
    <a href={`/${lang}/`} class="nav-brand"><img src="/logo.png" id="logoLight" alt="NickAlphaWhite" /><img src="/logo-light.png" id="logoDark" alt="NickAlphaWhite" style="display:none" /></a>
    <!-- Desktop links — hidden on mobile -->
    {orderedCategories.map((cat, i) => (
      <a href={`/${lang}/category/${cat}`} class={`nav-link nav-main-cat${i >= 8 ? " nav-extra" : ""}${i >= 6 ? " nav-secondary" : ""}${cat === activeCat ? " active" : ""}`} data-cat={cat}>{catLabel(cat)}</a>
    ))}
    <details class={`nav-more${orderedCategories.length > 8 ? " nav-more-xl" : ""}${orderedCategories.length > 6 ? " nav-more-md" : ""}`}>
      <summary class="nav-more-trigger">{moreLabel} <span aria-hidden="true">⌄</span></summary>
      <div class="nav-more-popup">
        {orderedCategories.map((cat, i) => (
          <a href={`/${lang}/category/${cat}`} class={`nav-more-entry${i < 6 ? " nav-more-core" : i < 8 ? " nav-more-middle" : ""}${cat === activeCat ? " is-active" : ""}`}>{catLabel(cat)}</a>
        ))}
      </div>
    </details>
    <div class="nav-right">
      {showDropdowns && (
        <a href="/choose-country-region/" class="nav-region-btn" aria-label="选择国家或地区 / Choose country or region" title="Choose country or region">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a16 16 0 0 1 0 18M12 3a16 16 0 0 0 0 18"/></svg>
        </a>
      )}
      <button class="theme-btn" onclick="toggleTheme()" aria-label="Toggle theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      {showSearch && (
        <button class="search-btn" onclick="openSearch()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      )}
      <!-- Hamburger — visible on mobile -->
      <button class="hamburger" id="hamburger" onclick="toggleMobileMenu()" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile fullscreen menu -->
<div class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu-inner">
    {orderedCategories.map(cat => {
      const d = ddObj[cat];
      const subs = d?.subcategories || [];
      return (
        <>
          <a href={`/${lang}/category/${cat}`} class="mobile-cat" onclick="closeMobileMenu()">{catLabel(cat)}</a>
          {subs.map((s: any) => (
            <a href={s.url} class="mobile-sub" onclick="closeMobileMenu()">{s.name}</a>
          ))}
        </>
      );
    })}
  </div>
</div>

{showDropdowns && (
  <>
    <div class="nav-dropdown" id="navDropdown">
      <div class="mega-inner" id="megaInner"></div>
    </div>
    <div class="nav-backdrop" id="navBackdrop"></div>
  </>
)}

<div id="__ddData" style="display:none" data-json={JSON.stringify(ddObj)}></div>
<script>
  function __loadDD() {
    var el = document.getElementById('__ddData');
    if (el) { try { window.__DD = JSON.parse(el.dataset.json); } catch(e) {} }
  }
  __loadDD();
  document.addEventListener('astro:after-swap', __loadDD);
</script>

<script>
  window.toggleMobileMenu = function() {
    var menu = document.getElementById('mobileMenu');
    var btn = document.getElementById('hamburger');
    if (!menu || !btn) return;
    menu.classList.toggle('open');
    btn.classList.toggle('open');
    document.body.style.overflow = menu.classList.contains('open') ? 'hidden' : '';
  };
  window.closeMobileMenu = function() {
    var menu = document.getElementById('mobileMenu');
    var btn = document.getElementById('hamburger');
    if (!menu || !btn) return;
    menu.classList.remove('open');
    btn.classList.remove('open');
    document.body.style.overflow = '';
  };
</script>

<style>
/* Hamburger button */
.hamburger{display:none;width:36px;height:36px;border:none;background:transparent;cursor:pointer;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:6px;border-radius:50%;transition:background 0.2s var(--ease)}
.hamburger:hover{background:var(--bg3)}
.hamburger span{display:block;width:18px;height:2px;background:var(--txt2);border-radius:1px;transition:all 0.3s var(--ease)}
.hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.hamburger.open span:nth-child(2){opacity:0}
.hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

/* Mobile fullscreen menu */
.mobile-menu{display:none;position:fixed;inset:0;top:52px;z-index:150;background:var(--bg);overflow-y:auto;-webkit-overflow-scrolling:touch}
.mobile-menu.open{display:block}
.mobile-menu-inner{max-width:600px;margin:0 auto;padding:32px 32px 64px;display:flex;flex-direction:column}
.mobile-cat{font-size:1.4rem;font-weight:700;color:var(--txt);letter-spacing:-0.02em;padding:16px 0;border-bottom:1px solid var(--hairline);text-decoration:none;transition:opacity 0.15s}
.mobile-cat:hover{opacity:0.5}
.mobile-sub{font-size:0.95rem;color:var(--txt2);padding:9px 0 9px 20px;text-decoration:none;transition:color 0.15s}
.mobile-sub:hover{color:var(--txt)}

/* Responsive */
@media(max-width:900px){
  .nav-inner{padding:0 20px;gap:12px;justify-content:flex-start}
  .nav-link{display:none}
  .nav-brand{flex:1}
  .nav-brand img{height:24px;width:auto}
  .hamburger{display:flex}
  .nav-dropdown,.nav-backdrop{display:none!important}
}

/* Expanded top navigation: eight links at wide widths, six at medium widths. */
.nav-main-cat.nav-extra{display:none}
.nav-more{display:none;position:relative;height:52px;align-items:center;flex-shrink:0}
.nav-more.nav-more-xl{display:flex}
.nav-more-trigger{list-style:none;display:flex;align-items:center;gap:6px;padding:0 8px;height:52px;cursor:pointer;font-size:.9rem;font-weight:500;color:var(--txt2);white-space:nowrap;user-select:none}
.nav-more-trigger::-webkit-details-marker{display:none}
.nav-more-trigger span{font-size:1rem;line-height:1;transform:translateY(-2px)}
.nav-more[open] .nav-more-trigger,.nav-more-trigger:hover{color:var(--txt)}
.nav-more-popup{position:absolute;z-index:115;top:48px;right:-12px;min-width:168px;padding:8px;background:var(--card);border:1px solid var(--hairline);border-radius:12px;box-shadow:0 12px 40px rgba(0,0,0,.13)}
.nav-more-entry{display:block;padding:10px 13px;border-radius:7px;color:var(--txt2);font-size:.88rem;white-space:nowrap}
.nav-more-entry:hover,.nav-more-entry.is-active{color:var(--txt);background:var(--bg3)}
.nav-more-entry.nav-more-core,.nav-more-entry.nav-more-middle{display:none}
.nav-region-btn{width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:50%;color:var(--txt2)}
.nav-region-btn:hover{color:var(--txt);background:var(--bg3)}
@media(max-width:1220px) and (min-width:901px){
  .nav-main-cat.nav-secondary{display:none}
  .nav-more.nav-more-md{display:flex}
  .nav-more-entry.nav-more-middle{display:block}
  .nav-inner{padding:0 25px;gap:2px}
}
@media(max-width:900px){
  .nav-more{display:none!important}
}
@media(max-width:380px){.nav-region-btn{display:none}}
</style>
